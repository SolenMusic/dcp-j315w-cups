ARG RUNTIME_IMAGE=debian:bookworm-slim
FROM ${RUNTIME_IMAGE}
RUN if command -v apt-get >/dev/null; then \
      apt-get update && apt-get install -y --no-install-recommends cups cups-client cups-filters ghostscript libcups2-dev python3 file; \
    elif command -v dnf >/dev/null; then \
      dnf install -y cups cups-client cups-filters ghostscript cups-devel python3 file; \
    elif command -v pacman >/dev/null; then \
      pacman -Syu --noconfirm --needed cups cups-filters ghostscript python file qpdf; \
    elif command -v zypper >/dev/null; then \
      zypper --non-interactive install cups cups-client cups-filters ghostscript cups-devel python3 file; \
    else exit 1; fi
WORKDIR /source
COPY . .
# The executable from the release build is supplied separately by CI. Do not
# silently rebuild it against the newer runtime under test.
COPY release-filter/rastertodcpj315w /source/rastertodcpj315w
RUN chmod 755 rastertodcpj315w
CMD ["/bin/bash", "-c", "python3 test_linux.py && python3 test_installation_linux.py"]
