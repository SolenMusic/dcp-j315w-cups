FROM alpine:3.24
RUN apk add --no-cache build-base cups-dev cups cups-client cups-filters \
    ghostscript python3 file binutils bash tar gzip
WORKDIR /source
COPY . .
RUN ./install-deps.sh && ./build.sh && file rastertodcpj315w && \
    file -b rastertodcpj315w | grep 'ld-musl' && \
    python3 test_reliability.py && python3 test_discovery.py && python3 test_status.py && \
    cc -std=c11 -Wall -Wextra -Werror make_geometry_probe.c $(cups-config --cflags --ldflags --libs) -o /tmp/make_geometry_probe && \
    python3 test_geometry.py /tmp/make_geometry_probe
CMD ["/bin/bash", "-c", "python3 test_linux.py && python3 test_installation_linux.py"]
